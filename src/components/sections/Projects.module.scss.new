// Modern Projects Section Styles
@use 'sass:color';

// Variables
:root {
  // Colors
  --primary: #6366f1;
  --primary-light: #818cf8;
  --primary-dark: #4f46e5;
  --dark: #0f172a;
  --darker: #0a0f1e;
  --light: #f8fafc;
  --gray: #94a3b8;
  --gray-dark: #475569;
  
  // Glass effect
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.1);
  --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
  
  // Spacing
  --spacing-xs: 0.5rem;
  --spacing-sm: 1rem;
  --spacing-md: 1.5rem;
  --spacing-lg: 2rem;
  --spacing-xl: 3rem;
  
  // Border radius
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  
  // Transitions
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

// Mixins
@mixin flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

@mixin glass-effect($opacity: 0.1, $blur: 10px) {
  background: rgba(255, 255, 255, $opacity);
  backdrop-filter: blur($blur);
  -webkit-backdrop-filter: blur($blur);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
}

@mixin card-hover-effect {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), 0 8px 16px rgba(0, 0, 0, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

// Animations
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
  100% { transform: translateY(0px); }
}

@keyframes gradientBG {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

// Main container
.projects {
  position: relative;
  padding: 6rem 0;
  background: linear-gradient(135deg, var(--darker) 0%, var(--dark) 100%);
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.3), transparent);
  }
  
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    position: relative;
    z-index: 1;
  }
  
  // Section header
  .sectionHeader {
    text-align: center;
    margin-bottom: 4rem;
    
    .sectionTitle {
      font-size: 3rem;
      font-weight: 800;
      background: linear-gradient(to right, #fff, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 1rem;
      line-height: 1.2;
      
      @media (max-width: 768px) {
        font-size: 2.25rem;
      }
    }
    
    .sectionSubtitle {
      color: var(--gray);
      font-size: 1.25rem;
      max-width: 700px;
      margin: 0 auto;
      line-height: 1.6;
      
      @media (max-width: 768px) {
        font-size: 1.1rem;
      }
    }
  }
  
  // Projects grid
  .projectsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--spacing-lg);
    margin: 0 auto;
    
    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
  
  // Project card
  .projectCard {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition-slow);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    height: 100%;
    
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-lg);
      padding: 1px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.3), rgba(99, 102, 241, 0));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
      z-index: 1;
    }
    
    &:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
      border-color: rgba(99, 102, 241, 0.3);
      
      .projectImage {
        transform: scale(1.05);
      }
      
      .projectContent {
        background: linear-gradient(to top, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.8));
      }
    }
    
    &.featured {
      position: relative;
      overflow: visible;
      
      &::after {
        content: 'Featured';
        position: absolute;
        top: -12px;
        right: 20px;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        z-index: 2;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
      }
    }
  }
  
  // Project image container
  .projectImageContainer {
    position: relative;
    width: 100%;
    padding-top: 60%;
    overflow: hidden;
    background: #0f172a;
    
    .projectImage {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }
    
    .imagePlaceholder {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(45deg, #1e293b, #334155);
      @include flex-center;
      
      svg {
        width: 4rem;
        height: 4rem;
        color: rgba(255, 255, 255, 0.1);
      }
    }
  }
  
  // Project content
  .projectContent {
    padding: var(--spacing-md);
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    background: rgba(15, 23, 42, 0.7);
    
    .projectTitle {
      font-size: 1.5rem;
      font-weight: 700;
      color: white;
      margin: 0 0 var(--spacing-xs);
      line-height: 1.3;
    }
    
    .projectDescription {
      color: var(--gray);
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0 0 var(--spacing-md);
      flex-grow: 1;
    }
    
    .projectTags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: var(--spacing-md);
      
      .tag {
        background: rgba(99, 102, 241, 0.1);
        color: var(--primary-light);
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        transition: var(--transition);
        
        &:hover {
          background: rgba(99, 102, 241, 0.2);
        }
      }
    }
    
    .projectFooter {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      
      .projectLinks {
        display: flex;
        gap: 0.75rem;
        
        a {
          @include flex-center;
          width: 2.5rem;
          height: 2.5rem;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.05);
          color: var(--gray);
          transition: var(--transition);
          
          &:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
          }
          
          svg {
            width: 1.25rem;
            height: 1.25rem;
          }
        }
      }
      
      .projectTech {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        
        .techIcon {
          width: 1.5rem;
          height: 1.5rem;
          color: var(--gray);
          transition: var(--transition);
          
          &:hover {
            color: var(--primary-light);
            transform: translateY(-2px);
          }
        }
      }
    }
  }
  
  // Modal styles
  .modalOverlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 2rem;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    
    &.active {
      opacity: 1;
      visibility: visible;
      
      .modal {
        transform: translateY(0);
        opacity: 1;
      }
    }
  }
  
  .modal {
    background: #0f172a;
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 1000px;
    max-height: 90vh;
    overflow: hidden;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    
    .modalHeader {
      padding: var(--spacing-md);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
      
      .modalTitle {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin: 0;
      }
      
      .closeButton {
        background: none;
        border: none;
        color: var(--gray);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 50%;
        transition: var(--transition);
        
        &:hover {
          background: rgba(255, 255, 255, 0.05);
          color: white;
        }
        
        svg {
          width: 1.5rem;
          height: 1.5rem;
        }
      }
    }
    
    .modalBody {
      padding: var(--spacing-md);
      overflow-y: auto;
      flex-grow: 1;
      
      .modalImageContainer {
        position: relative;
        width: 100%;
        padding-top: 56.25%; // 16:9 aspect ratio
        border-radius: var(--radius-md);
        overflow: hidden;
        margin-bottom: var(--spacing-md);
        background: #0f172a;
        
        .modalImage {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        
        .modalNav {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          width: 100%;
          display: flex;
          justify-content: space-between;
          padding: 0 var(--spacing-sm);
          z-index: 2;
          
          button {
            @include flex-center;
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.5);
            border: none;
            color: white;
            cursor: pointer;
            transition: var(--transition);
            
            &:hover {
              background: var(--primary);
              transform: translateY(-2px);
            }
            
            &:disabled {
              opacity: 0.3;
              cursor: not-allowed;
              transform: none;
              
              &:hover {
                background: rgba(0, 0, 0, 0.5);
              }
            }
            
            svg {
              width: 1.5rem;
              height: 1.5rem;
            }
          }
        }
        
        .imageCounter {
          position: absolute;
          bottom: var(--spacing-sm);
          left: 50%;
          transform: translateX(-50%);
          background: rgba(0, 0, 0, 0.7);
          color: white;
          font-size: 0.8rem;
          padding: 0.25rem 0.75rem;
          border-radius: 20px;
          z-index: 2;
        }
      }
      
      .modalDescription {
        color: var(--gray);
        line-height: 1.7;
        margin-bottom: var(--spacing-md);
        
        p {
          margin-bottom: 1rem;
          
          &:last-child {
            margin-bottom: 0;
          }
        }
      }
      
      .featuresList {
        margin: var(--spacing-md) 0;
        
        h4 {
          color: white;
          font-size: 1.1rem;
          margin-bottom: var(--spacing-sm);
        }
        
        ul {
          list-style: none;
          padding: 0;
          margin: 0;
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
          gap: 0.5rem;
          
          @media (max-width: 640px) {
            grid-template-columns: 1fr;
          }
          
          li {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            color: var(--gray);
            font-size: 0.95rem;
            line-height: 1.6;
            
            &::before {
              content: '→';
              color: var(--primary);
              font-weight: bold;
              margin-top: 0.2rem;
            }
          }
        }
      }
      
      .techStack {
        margin: var(--spacing-md) 0;
        
        h4 {
          color: white;
          font-size: 1.1rem;
          margin-bottom: var(--spacing-sm);
        }
        
        .techIcons {
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
          
          .techItem {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            
            .techIcon {
              width: 2.5rem;
              height: 2.5rem;
              color: var(--gray);
              transition: var(--transition);
              
              &:hover {
                color: var(--primary);
                transform: translateY(-3px);
              }
            }
            
            .techName {
              font-size: 0.7rem;
              color: var(--gray);
              text-align: center;
            }
          }
        }
      }
    }
    
    .modalFooter {
      padding: var(--spacing-md);
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      justify-content: flex-end;
      gap: 1rem;
      
      @media (max-width: 640px) {
        flex-direction: column;
      }
      
      a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius-sm);
        font-weight: 500;
        text-decoration: none;
        transition: var(--transition);
        font-size: 0.95rem;
        
        &.githubLink {
          background: rgba(255, 255, 255, 0.05);
          color: white;
          border: 1px solid rgba(255, 255, 255, 0.1);
          
          &:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
          }
        }
        
        &.liveLink {
          background: var(--primary);
          color: white;
          border: 1px solid var(--primary-dark);
          
          &:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
          }
        }
        
        svg {
          width: 1.1rem;
          height: 1.1rem;
        }
      }
    }
  }
  
  // Responsive adjustments
  @media (max-width: 1024px) {
    .projectsGrid {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }
  
  @media (max-width: 768px) {
    padding: 4rem 0;
    
    .sectionHeader {
      margin-bottom: 3rem;
      
      .sectionTitle {
        font-size: 2.25rem;
      }
      
      .sectionSubtitle {
        font-size: 1.1rem;
        padding: 0 var(--spacing-sm);
      }
    }
    
    .modal {
      max-height: 85vh;
      
      .modalBody {
        padding: var(--spacing-sm);
      }
    }
  }
  
  @media (max-width: 480px) {
    .sectionHeader {
      .sectionTitle {
        font-size: 2rem;
      }
      
      .sectionSubtitle {
        font-size: 1rem;
      }
    }
    
    .projectCard {
      .projectContent {
        .projectTitle {
          font-size: 1.3rem;
        }
        
        .projectDescription {
          font-size: 0.9rem;
        }
      }
    }
    
    .modal {
      .modalHeader {
        .modalTitle {
          font-size: 1.25rem;
        }
      }
      
      .modalBody {
        .modalDescription {
          font-size: 0.95rem;
        }
        
        .featuresList {
          h4 {
            font-size: 1rem;
          }
          
          ul {
            li {
              font-size: 0.9rem;
            }
          }
        }
      }
    }
  }
}
